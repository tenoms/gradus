# 可选环境覆盖。完整默认值见 config/defaults.json，本机设置见 config/local.json。
# 优先级：默认文件 < 本机文件（或 STUDY_CONFIG_FILE 指定文件）< 环境变量。
# 仅取消需要覆盖的配置项；秘密字段设为空字符串会显式清空对应初值。

# 使用其他部署文件时指定绝对路径或相对仓库根的路径。
# STUDY_CONFIG_FILE=/etc/study/config.json

# 数据库也可只在 config/local.json 的 runtime.database.url 配置。
# DATABASE_URL=postgresql://study:change-me@127.0.0.1:5432/study
# STUDY_SCHEMA_PREFIX=study
# HOST=127.0.0.1
# PORT=3001
# COOKIE_SECURE=1

# 平台环境覆盖仅用于数据库中配置首次建立；后续通过管理空间维护。
# YYB_BASE_URL=
# YYB_API_KEY=
# MATH_ENABLED=1
# MATH_BASE_URL=
# MATH_APP_ID=
# MATH_STATION_ID=
# MATH_LOGIN_ID=
# MATH_OCR_URL=
# MATH_OCR_USERNAME=
# MATH_OCR_PASSWORD=
# COMPUTER_ENABLED=1
# COMPUTER_BASE_URL=
# COMPUTER_APP_ID=
# COMPUTER_TENANT_CODE=
# COMPUTER_OAUTH_CLIENT_ID=
# COMPUTER_OAUTH_CLIENT_SECRET=
# COMPUTER_VIDEO_KEY=
# COMPUTER_VIDEO_IV=
