# 复制为 .env 后填写；.env 不提交。
DATABASE_URL=postgresql://study:change-me@127.0.0.1:5432/study
STUDY_SCHEMA_PREFIX=study

# 以下部署覆盖项可选，默认值见 config/system.json 的 runtime。
# HOST=127.0.0.1
# PORT=3001
# COOKIE_SECURE=1

# 平台字段：未定义时由管理端维护；显式定义时优先于管理端。
# 空字符串也属于显式定义，可用于清空可选值。修改 .env 后重启服务。
# 只填写要由本机环境控制的字段；下列注释不是生效配置。

# 系统默认 YYB 服务：填写服务根地址，API Key 可选。
# YYB_BASE_URL=
# YYB_API_KEY=

# 数学：启用时填写 API 根地址、微信 App ID、站点及登录编号。
# MATH_ENABLED=1
# MATH_BASE_URL=
# MATH_APP_ID=
# MATH_STATION_ID=
# MATH_LOGIN_ID=
# 图片识别接口为完整 URL，凭据由服务提供方提供。
# MATH_OCR_URL=
# MATH_OCR_USERNAME=
# MATH_OCR_PASSWORD=

# 计算机：启用时填写 API 根地址、微信 App ID、租户和 OAuth 配置。
# COMPUTER_ENABLED=1
# COMPUTER_BASE_URL=
# COMPUTER_APP_ID=
# COMPUTER_TENANT_CODE=
# COMPUTER_OAUTH_CLIENT_ID=
# COMPUTER_OAUTH_CLIENT_SECRET=
# 录播 AES Key / IV 均为 16 字节 UTF-8 文本。
# COMPUTER_VIDEO_KEY=
# COMPUTER_VIDEO_IV=

# 仅发送给浏览器的公开地址，独立于平台管理配置；无值时对应功能不可用。
# 数学外部页面 URL 前缀，应以 / 结尾，例如 https://pages.example.test/External/
# MATH_EXTERNAL_URL=
# MATH_PRINT_STATION_ID=1
