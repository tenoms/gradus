# Node 22.13+。复制为 .env 后，使用 node --env-file=.env server/index.mjs。
PORT=3001
HOST=127.0.0.1
# HTTPS 部署请设为 1。
COOKIE_SECURE=0

# PostgreSQL 14+；身份/学习数据与上游资源使用独立 schema。
# 本地开发连接请填写实际数据库，凭据仅保存在未提交的 .env。
DATABASE_URL=postgresql://study:your-password@192.168.1.188:5432/study
# 默认 study，生成 study_web 和 study_upstream 两个 schema。
STUDY_SCHEMA_PREFIX=study

# 下列值仅作为配置数据库首次建立时的初值，之后在 /admin/ 的“平台配置”管理。
# YYB 服务地址留空时，本机从未提交的 yyb.txt 读取。
YYB_BASE_URL=
# 仅当 YYB 部署要求鉴权时填写。
YYB_API_KEY=

# 可选：上游正式服务覆盖；通常留空使用公开的原平台域名。
MATH_BASE_URL=
COMPUTER_BASE_URL=
MATH_ENABLED=1
MATH_APP_ID=<math-app-id>
MATH_STATION_ID=1
MATH_LOGIN_ID=2
COMPUTER_ENABLED=1
COMPUTER_APP_ID=<computer-app-id>
COMPUTER_TENANT_CODE=1
COMPUTER_OAUTH_CLIENT_ID=
COMPUTER_OAUTH_CLIENT_SECRET=

# 数学拍照识别服务；本地可读取原小程序未提交的配置。
# 部署时填写，禁止把凭据放入 VITE_* 变量。
MATH_OCR_URL=
MATH_OCR_USERNAME=
MATH_OCR_PASSWORD=

# 计算机录播地址 AES 解密（UTF-8，均为16字节）。
# 本地留空时只读取未提交的原小程序配置；部署时由服务器环境提供。
COMPUTER_VIDEO_KEY=
COMPUTER_VIDEO_IV=
