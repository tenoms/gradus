# Node 22.13+。复制为 .env 后，使用 node --env-file=.env server/index.mjs。
PORT=3001
HOST=127.0.0.1
# HTTPS 部署请设为 1。
COOKIE_SECURE=0

# Web 用户、登录会话、学习计划和审计的 SQLite 数据库；默认 .data/study.sqlite。
# 第一次访问先创建管理员，再由管理员创建学习者并分配 YYB 账号。
STUDY_DATABASE_PATH=

# 在服务端填写自己的 YYB 服务地址。留空时仅本地读取未提交的 yyb.txt。
YYB_BASE_URL=
# 仅当 YYB 部署要求鉴权时填写。
YYB_API_KEY=

# 可选：上游正式服务覆盖；通常留空使用公开的原平台域名。
MATH_BASE_URL=
COMPUTER_BASE_URL=

# 数学拍照识别服务；本地可读取原小程序未提交的配置。
# 部署时填写，禁止把凭据放入 VITE_* 变量。
MATH_OCR_URL=
MATH_OCR_USERNAME=
MATH_OCR_PASSWORD=

# 计算机录播地址 AES 解密（UTF-8，均为16字节）。
# 本地留空时只读取未提交的原小程序配置；部署时由服务器环境提供。
COMPUTER_VIDEO_KEY=
COMPUTER_VIDEO_IV=
