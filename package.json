{
  "name": "study-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node --env-file-if-exists=.env --watch server/index.mjs\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.mjs\"",
    "typecheck": "tsc -b",
    "verify:spaces": "node scripts/checks/bundles.mjs",
    "verify:directories": "node --experimental-strip-types scripts/live/directory-loading.mjs",
    "check": "npm run verify:repo && npm run typecheck && npm test && npm run verify:spaces",
    "verify:repo": "node scripts/checks/repository.mjs",
    "verify:data-architecture": "node --experimental-strip-types scripts/live/data-architecture.mjs",
    "verify:resource-local-first": "node --experimental-strip-types scripts/live/resource-local-first.mjs",
    "verify:personal-sync": "node --experimental-strip-types scripts/live/personal-sync.mjs",
    "verify:system-yyb": "node --experimental-strip-types scripts/live/system-yyb.mjs",
    "verify:tokens": "node --experimental-strip-types scripts/live/token-lifecycle.mjs",
    "clean": "node scripts/maintenance/clean.mjs",
    "clean:reports": "node scripts/maintenance/clean.mjs --reports"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.2.7",
    "express": "^5.1.0",
    "hls.js": "^1.7.4",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "marked": "^18.1.2",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
